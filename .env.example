# voiceAgent — environment variables
# Copy this file to .env and fill in your keys. Never commit .env.
#
# At minimum you need ONE provider key. The agent defaults to Anthropic
# (claude-opus-5); pass --model groq:... or --model gemini:... to switch.

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Groq (optional — fastest first-sentence latency) ─────────────────────────
# Simple single key:
GROQ_API_KEY=gsk_...

# Key pool (optional): JSON array rotated on 429 / daily cap.
# Each entry: {"key": "gsk_...", "label": "key0", "proxy": "http://..."}
# "proxy" and "label" are optional. Remove entries you don't need.
# GROQ_KEYS=[{"key":"gsk_...","label":"key0"},{"key":"gsk_...","label":"key1"}]

# ── Google Gemini (optional) ──────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy...
